# Supabase public configuration. Required for Supabase-backed auth/data flows.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase key. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only AI provider keys. Do not create NEXT_PUBLIC_ versions.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional automation placeholder only. Do not commit a real token.
GITHUB_PAT=ghp_REPLACE_WITH_REAL_TOKEN_IN_GITHUB_OR_VERCEL_SECRETS
